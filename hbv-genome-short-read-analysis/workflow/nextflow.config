// Local execution profile for the HBV downstream workflow.
// The workflow assumes the raw FASTQ files, the pixi environments and the
// nf-core/viralrecon outputs already exist (see README.md).

params {
    input           = "${launchDir}/samplesheet.csv"
    reference       = "${launchDir}/references/hbv_reference.fasta"
    extended_reference = "${launchDir}/references/hbv_reference.extended.fasta"
    public_fasta    = "${launchDir}/references/hbv_public_genomes.fasta"
    public_metadata = "${launchDir}/references/hbv_metadata.tsv"
    sample_metadata = "${launchDir}/metadata/selected_samples.tsv"
    viralrecon_dir  = "${launchDir}/results/viralrecon"
    outdir          = "${launchDir}/results_nf"
    script_dir      = "${projectDir}/../bin"
    cpus            = 8
}

profiles {
    local {
        process.executor = 'local'
        docker.enabled   = false
    }
    // Placeholder for the containerised re-run.  Add a process-level
    // `container` directive (or a profile such as nf-core's `apptainer`)
    // before using this profile on a host with Apptainer installed.
    apptainer {
        apptainer.enabled = true
    }
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '14 GB'
}

process {
    executor       = 'local'
    stageInMode    = 'copy'
    cpus           = 2
    memory         = '4 GB'
    time           = '2h'
    maxForks       = 4
    errorStrategy  = 'retry'
    maxRetries     = 1
    resourceLimits = [cpus: 8, memory: 14.GB, time: 12.h]
}

workDir = 'work'
