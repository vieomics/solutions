// Local execution profile for this workspace.
//
// The sandbox has no Docker/Apptainer runtime, so the stock nf-core pipeline is
// executed with tools from the project's pixi environment.  The custom genome
// entry below is required because viralrecon resolves --fasta through
// params.genomes; using --genome hbv keeps the reference path portable.

params {
    genomes {
        hbv {
            fasta = "${launchDir}/references/hbv_reference.fasta"
        }
    }
    max_cpus   = 8
    max_memory = '14.GB'
    max_time   = '12.h'
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '14 GB'
}

process {
    executor      = 'local'
    stageInMode   = 'copy'
    maxForks      = 4
    resourceLimits = [
        cpus: 8,
        memory: 14.GB,
        time: 12.h,
    ]
}

workDir = 'work'
