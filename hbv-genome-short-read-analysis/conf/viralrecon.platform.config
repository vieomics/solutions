// Public HBV reference override for nf-core/viralrecon.
// Stored under the public analysis prefix; users do not edit it.

params {
    genomes {
        hbv {
            fasta = "s3://omicslab/data/analysis/PRJNA659786/references/hbv_reference.fasta"
        }
    }
    // Mirror the pipeline's own conf/test_metagenomic.config. The pipeline
    // leaves variant_caller = null and derives the caller inside the workflow,
    // but conf/modules_illumina.config reads params.variant_caller while
    // building ext.args and publishDir. With null the 75% ALT_FREQ filter is
    // dropped and consensus is written to variants/null/consensus/bcftools.
    trim_primers      = false
    variant_caller    = 'bcftools'
    publish_dir_mode  = 'copy'
}

// The platform deletes work/ before uploading results/. Make sure published
// files are real copies, not symlinks into work/, otherwise the upload fails.
workflow.output.mode = 'copy'
workflow {
    onComplete = {
        def out = new File("${params.outdir}")
        if (out.exists()) {
            // Reference indexes are not needed downstream.
            def genome = new File(out, "genome")
            if (genome.exists()) {
                genome.deleteDir()
            }
            // Dereference every remaining symlink before the platform removes work/.
            def real = new File("${params.outdir}_real")
            def cmd = "cp -aL '${out}' '${real}' && rm -rf '${out}' && mv '${real}' '${out}'"
            def proc = ["bash", "-c", cmd].execute()
            proc.waitFor()
        }
    }
}

// The pipeline includes conf/modules_illumina.config from conf/modules.config
// only when params.platform is already set while the config is parsed. CLI
// params are applied after nextflow.config, so on the platform params.platform
// is still null at that point and every illumina ext.args is silently lost.
// Include the module settings explicitly or BCFTOOLS_MPILEUP runs without
// --annotate and `bcftools call` fails with "Expected -c or -m option".
includeConfig "${projectDir}/conf/modules_illumina.config"
