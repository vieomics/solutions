// Project resource policy.
//
// CPU:RAM ratio of 1:2 (2 GB per CPU), with process_medium at 16:32.
// Loaded via `-c conf/resources.config` *after* the pipeline and user configs,
// so these values take precedence over the nf-core defaults (which use
// 1 CPU : 6 GB for process_single).
//
// Host: worker-01 — 79 CPUs, 256 GB RAM.

process {
    cpus   = 1
    memory = 2.GB

    withLabel:process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel:process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel:process_medium {
        cpus   = 16
        memory = { 32.GB * task.attempt }
    }
    withLabel:process_high {
        cpus   = 16
        memory = { 32.GB * task.attempt }
    }
}
